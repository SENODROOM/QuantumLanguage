# The static type checker, written in Quantum: a port of src/TypeChecker.cpp.
# Warnings only (to stderr) — a declared C/C++ type whose initializer has an
# incompatible type; nothing in the program changes.

let TC_YELLOW = chr(27) + "[33m"
let TC_RESET = chr(27) + "[0m"
let TC_NUMERIC = {"int": true, "float": true, "double": true, "long": true, "short": true, "unsigned": true,
                  "unsigned int": true, "long long": true, "unsigned long": true, "size_t": true, "char": true,
                  "number": true, "bool": true}
let TC_ENUM_TYPES = {}

fn tcEnv(parent) {
    return {"vars": {}, "parent": parent}
}

fn tcResolve(env, name) {
    while env != nil {
        if name in env["vars"] {
            return env["vars"][name]
        }
        env = env["parent"]
    }
    return "any"
}

# whether a `found` value may initialize a variable declared `declared`
fn tcCompatible(declared, found) {
    if declared == found {
        return true
    }
    if (declared == "str" or declared == "String") and found == "string" {
        return true
    }
    if declared == "char" and found == "string" {
        return true
    }
    return declared in TC_NUMERIC and found in TC_NUMERIC
}

fn tcNonNumeric(t) {
    return t != "any" and !tcCompatible("double", t)
}

fn tcCheckNode(node, env) {
    if node == nil {
        return "void"
    }
    let k = node["k"]
    if k == "Number" {
        let v = node["value"]
        if floor(v) == v {
            return "int"
        }
        return "float"
    }
    if k == "String" {
        return "string"
    }
    if k == "Bool" {
        return "bool"
    }
    if k == "Ident" {
        return tcResolve(env, node["name"])
    }
    if k == "VarDecl" {
        let initType = "any"
        if node["initializer"] != nil {
            initType = tcCheckNode(node["initializer"], env)
        }
        let hint = node["typeHint"]
        let declaredType = hint
        if hint == "" {
            declaredType = initType
        }
        # an enum constant (`Color::Red`) makes `Color` an enum type
        let name = node["name"]
        let scope = name.indexOf("::")
        if scope > 0 {
            TC_ENUM_TYPES[name.slice(0, scope)] = true
        }
        if hint != "" and hint != "any" and initType != "any" and !tcCompatible(hint, initType) and !(hint in TC_ENUM_TYPES and tcCompatible("int", initType)) {
            fprintf("stderr", "%s", TC_YELLOW + "[StaticTypeWarning] " + TC_RESET + "Type mismatch for '" + name + "'. Found " + initType + " but expected " + hint + " (line " + str(node["line"]) + ")\n")
        }
        env["vars"][name] = declaredType
        return "void"
    }
    if k == "FunctionDecl" {
        let subEnv = tcEnv(env)
        let params = node["params"]
        let types = node["paramTypes"]
        let i = 0
        while i < len(params) {
            let pType = "any"
            if i < len(types) and types[i] != "" {
                pType = types[i]
            }
            subEnv["vars"][params[i]] = pType
            i = i + 1
        }
        tcCheckNode(node["body"], subEnv)
        env["vars"][node["name"]] = "fn"
        return "void"
    }
    if k == "Block" {
        # `T a, b(1);` is a block of declarations of the enclosing scope
        let stmts = node["statements"]
        let declList = len(stmts) > 0
        for st in stmts {
            declList = declList and st != nil and st["k"] == "VarDecl"
        }
        let subEnv = env
        if !declList {
            subEnv = tcEnv(env)
        }
        for st in stmts {
            tcCheckNode(st, subEnv)
        }
        return "void"
    }
    if k == "Binary" {
        let left = tcCheckNode(node["left"], env)
        let right = tcCheckNode(node["right"], env)
        let op = node["op"]
        if op == "+" or op == "-" or op == "*" or op == "/" {
            if tcNonNumeric(left) or tcNonNumeric(right) {
                return "any"
            }
            return "float"
        }
        if op == "==" or op == "!=" or op == "<" or op == ">" {
            return "bool"
        }
        return "any"
    }
    if k == "Call" {
        tcCheckNode(node["callee"], env)
        for a in node["args"] {
            tcCheckNode(a, env)
        }
        return "any"
    }
    if k == "ExprStmt" {
        return tcCheckNode(node["expr"], env)
    }
    if k == "Return" {
        return tcCheckNode(node["value"], env)
    }
    return "any"
}

fn typeCheck(ast) {
    TC_ENUM_TYPES = {}
    let globalEnv = tcEnv(nil)
    globalEnv["vars"]["print"] = "any"
    globalEnv["vars"]["input"] = "string"
    globalEnv["vars"]["len"] = "int"
    globalEnv["vars"]["sha256"] = "string"
    globalEnv["vars"]["aes128"] = "string"
    if ast != nil and ast["k"] == "Block" {
        for st in ast["statements"] {
            tcCheckNode(st, globalEnv)
        }
    } else {
        tcCheckNode(ast, globalEnv)
    }
}
