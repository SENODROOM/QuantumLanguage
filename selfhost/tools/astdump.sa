# Prints the self-hosted parser's tree in the format of `qrun --dump-ast`:
#   qrun selfhost/tools/astdump.sa <file>
# @use "../parser_expr.sa"

let HEX_DIGITS = "0123456789ABCDEF"
let OUT = []

fn dumpEscaped(s) {
    let out = ""
    let i = 0
    let n = len(s)
    while i < n {
        let c = s[i]
        let code = ord(c)
        if c == "\\" {
            out = out + "\\\\"
        } else if c == "\n" {
            out = out + "\\n"
        } else if c == "\t" {
            out = out + "\\t"
        } else if c == "\r" {
            out = out + "\\r"
        } else if code < 32 or code == 127 {
            out = out + "\\x" + HEX_DIGITS[floor(code / 16)] + HEX_DIGITS[code % 16]
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out
}

fn q(s) {
    return "\"" + dumpEscaped(s) + "\""
}

fn listOf(v) {
    let parts = []
    for s in v {
        parts.push(q(s))
    }
    return "[" + parts.join(",") + "]"
}

fn flags(v) {
    let s = "["
    for b in v {
        if b {
            s = s + "1"
        } else {
            s = s + "0"
        }
    }
    return s + "]"
}

fn bit(b) {
    if b {
        return "1"
    }
    return "0"
}

fn pad(depth) {
    return " ".repeat(depth * 2)
}

fn dumpList(v, depth, label) {
    let i = 0
    while i < len(v) {
        dumpNode(v[i], depth, label + str(i))
        i = i + 1
    }
}

fn dumpNode(n, depth, label) {
    let head = pad(depth) + label + ": "
    if n == nil {
        OUT.push(head + "-")
        return nil
    }
    let d = depth + 1
    head = head + str(n["line"]) + " "
    let k = n["k"]
    if k == "Number" {
        OUT.push(head + "Number " + str(n["value"]))
    } else if k == "String" {
        OUT.push(head + "String " + q(n["value"]))
    } else if k == "Bool" {
        OUT.push(head + "Bool " + bit(n["value"]))
    } else if k == "Nil" {
        OUT.push(head + "Nil")
    } else if k == "Ident" {
        OUT.push(head + "Ident " + q(n["name"]))
    } else if k == "Binary" {
        OUT.push(head + "Binary " + q(n["op"]))
        dumpNode(n["left"], d, "left")
        dumpNode(n["right"], d, "right")
    } else if k == "Unary" {
        OUT.push(head + "Unary " + q(n["op"]))
        dumpNode(n["operand"], d, "operand")
    } else if k == "Assign" {
        OUT.push(head + "Assign " + q(n["op"]))
        dumpNode(n["target"], d, "target")
        dumpNode(n["value"], d, "value")
    } else if k == "Call" {
        OUT.push(head + "Call")
        dumpNode(n["callee"], d, "callee")
        dumpList(n["args"], d, "arg")
    } else if k == "Index" {
        OUT.push(head + "Index")
        dumpNode(n["object"], d, "object")
        dumpNode(n["index"], d, "index")
    } else if k == "Slice" {
        OUT.push(head + "Slice")
        dumpNode(n["object"], d, "object")
        dumpNode(n["start"], d, "start")
        dumpNode(n["stop"], d, "stop")
        dumpNode(n["step"], d, "step")
    } else if k == "Member" {
        OUT.push(head + "Member " + q(n["member"]))
        dumpNode(n["object"], d, "object")
    } else if k == "Array" {
        OUT.push(head + "Array")
        dumpList(n["elements"], d, "el")
    } else if k == "Dict" {
        OUT.push(head + "Dict")
        let i = 0
        for p in n["pairs"] {
            dumpNode(p[0], d, "key" + str(i))
            dumpNode(p[1], d, "val" + str(i))
            i = i + 1
        }
    } else if k == "Lambda" {
        OUT.push(head + "Lambda " + listOf(n["params"]) + " " + listOf(n["paramTypes"]) + " " + q(n["returnType"]))
        dumpList(n["defaultArgs"], d, "default")
        dumpNode(n["body"], d, "body")
    } else if k == "ListComp" {
        OUT.push(head + "ListComp " + listOf(n["vars"]))
        dumpNode(n["expr"], d, "expr")
        dumpNode(n["iterable"], d, "iterable")
        dumpNode(n["condition"], d, "condition")
    } else if k == "Tuple" {
        OUT.push(head + "Tuple")
        dumpList(n["elements"], d, "el")
    } else if k == "VarDecl" {
        OUT.push(head + "VarDecl " + q(n["name"]) + " " + q(n["typeHint"]) + " " + flags([n["isConst"], n["isPointer"], n["isExported"], n["cTyped"], n["perInstance"], n["isStatic"]]))
        dumpNode(n["initializer"], d, "init")
    } else if k == "FunctionDecl" {
        OUT.push(head + "FunctionDecl " + q(n["name"]) + " " + listOf(n["params"]) + " " + listOf(n["paramTypes"]) + " " + flags(n["paramIsRef"]) + " " + q(n["returnType"]) + " " + listOf(n["cppParamTypes"]) + " " + q(n["cReturnType"]) + " " + flags([n["isExported"], n["pythonScope"]]))
        dumpList(n["defaultArgs"], d, "default")
        dumpNode(n["body"], d, "body")
    } else if k == "Global" {
        OUT.push(head + "Global " + listOf(n["names"]) + " " + bit(n["isNonlocal"]))
    } else if k == "Return" {
        OUT.push(head + "Return")
        dumpNode(n["value"], d, "value")
    } else if k == "If" {
        OUT.push(head + "If")
        dumpNode(n["condition"], d, "cond")
        dumpNode(n["thenBranch"], d, "then")
        dumpNode(n["elseBranch"], d, "else")
    } else if k == "While" {
        OUT.push(head + "While")
        dumpNode(n["condition"], d, "cond")
        dumpNode(n["body"], d, "body")
        dumpNode(n["post"], d, "post")
    } else if k == "For" {
        OUT.push(head + "For " + q(n["var"]) + " " + q(n["var2"]))
        dumpNode(n["iterable"], d, "iterable")
        dumpNode(n["body"], d, "body")
    } else if k == "Block" {
        OUT.push(head + "Block")
        dumpList(n["statements"], d, "s")
    } else if k == "ExprStmt" {
        OUT.push(head + "ExprStmt")
        dumpNode(n["expr"], d, "expr")
    } else if k == "Print" {
        OUT.push(head + "Print " + bit(n["newline"]) + " " + q(n["sep"]) + " " + q(n["end"]))
        dumpList(n["args"], d, "arg")
    } else if k == "Input" {
        OUT.push(head + "Input " + q(n["target"]))
        dumpNode(n["prompt"], d, "prompt")
        dumpNode(n["lvalueTarget"], d, "lvalue")
    } else if k == "Break" {
        OUT.push(head + "Break")
    } else if k == "Continue" {
        OUT.push(head + "Continue")
    } else if k == "Super" {
        OUT.push(head + "Super " + q(n["method"]))
    } else if k == "Raise" {
        OUT.push(head + "Raise")
        dumpNode(n["value"], d, "value")
    } else if k == "Try" {
        OUT.push(head + "Try")
        dumpNode(n["body"], d, "body")
        let i = 0
        for h in n["handlers"] {
            OUT.push(pad(d) + "handler" + str(i) + ": " + q(h["errorType"]) + " " + q(h["alias"]))
            dumpNode(h["body"], d + 1, "body")
            i = i + 1
        }
        dumpNode(n["finallyBody"], d, "finally")
    } else if k == "Import" {
        let s = head + "Import " + q(n["module"])
        for it in n["imports"] {
            s = s + " " + q(it["name"]) + "=" + q(it["alias"])
        }
        OUT.push(s)
    } else if k == "Class" {
        OUT.push(head + "Class " + q(n["name"]) + " " + q(n["base"]))
        dumpList(n["methods"], d, "method")
        dumpList(n["staticMethods"], d, "static")
        dumpList(n["fields"], d, "field")
    } else if k == "Ternary" {
        OUT.push(head + "Ternary")
        dumpNode(n["condition"], d, "cond")
        dumpNode(n["thenExpr"], d, "then")
        dumpNode(n["elseExpr"], d, "else")
    } else if k == "AddressOf" {
        OUT.push(head + "AddressOf")
        dumpNode(n["operand"], d, "operand")
    } else if k == "Deref" {
        OUT.push(head + "Deref")
        dumpNode(n["operand"], d, "operand")
    } else if k == "Arrow" {
        OUT.push(head + "Arrow " + q(n["member"]))
        dumpNode(n["object"], d, "object")
    } else if k == "New" {
        OUT.push(head + "New " + q(n["typeName"]) + " " + bit(n["isArray"]))
        dumpList(n["args"], d, "arg")
        dumpNode(n["sizeExpr"], d, "size")
    } else {
        OUT.push(head + "?" + str(k))
    }
    return nil
}

let path = sys.argv[1]
let source = read_file(path)
if source == nil {
    print("ERROR\tcannot read " + path)
} else {
    source = source.split("\r\n").join("\n")
    let ok = true
    let ast = nil
    try {
        ast = parseProgram(lexTokenize(source), path.endsWith(".py"))
    } catch (e) {
        print("ERROR\t" + errorText(e))
        ok = false
    }
    if ok {
        dumpNode(ast, 0, "program")
        print(OUT.join("\n"))
    }
}
